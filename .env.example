# Base de Datos PostgreSQL en Hetzner (Docker)
POSTGRES_DB=stitch_pickup_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_seguro_postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/stitch_pickup_db

# Seguridad JWT (Debe ser una clave aleatoria de al menos 256 bits / 32+ caracteres)
JWT_SECRET=c3RpdGNoLXBpY2t1cC1qd3Qtc2VjcmV0LWtleS0yMDI2LXNlY3VyZS1oYXNoLWZvci1wcm9kdWN0aW9uLXN5c3RlbQ==
JWT_EXPIRATION_HOURS=24

# Orígenes Permitidos WebSocket (Usa '*' o tu dominio/IP de Hetzner)
WS_ALLOWED_ORIGINS=*

# Configuración Cloudinary
CLOUDINARY_URL=cloudinary://912463379929212:9CmlnIrFnEf4wbPISatNAAopJjU@lealtix-media
