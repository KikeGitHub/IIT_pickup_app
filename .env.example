# Base de Datos Serverless (Neon PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-holy-band-awa2j4it-pooler.c-12.us-east-1.aws.neon.tech/stitch_pickup_db?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=tu_password_de_neon

# Seguridad JWT (Debe ser una clave aleatoria de al menos 256 bits / 32+ caracteres)
JWT_SECRET=c3RpdGNoLXBpY2t1cC1qd3Qtc2VjcmV0LWtleS0yMDI2LXNlY3VyZS1oYXNoLWZvci1wcm9kdWN0aW9uLXN5c3RlbQ==
JWT_EXPIRATION_HOURS=24

# Orígenes Permitidos WebSocket (Usa '*' o tu dominio/IP de Hetzner)
WS_ALLOWED_ORIGINS=*

# Configuración JVM para Hetzner CPX22 (4 GB RAM)
JAVA_OPTS=-Xmx1024m -Xms256m -XX:+UseG1GC -XX:+UseStringDeduplication
